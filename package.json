{
  "name": "oskilifts",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:build": "expo export --platform web && node scripts/inject-supabase-config.js",
    "server": "node server/index.js",
    "test:sql": "node server/tests/local/run.mjs && node server/tests/local/backfill_check.mjs && node server/tests/local/limits_backfill_check.mjs",
    "test:unit": "node --import tsx --test \"src/domain/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.8.6",
    "@react-navigation/native": "^7.1.20",
    "@react-navigation/native-stack": "^7.6.3",
    "@supabase/supabase-js": "^2.49.1",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "expo": "~54.0.25",
    "expo-constants": "^18.0.10",
    "expo-location": "~19.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.8",
    "express": "^5.1.0",
    "html2canvas": "^1.4.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1313.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^26.6.4",
    "@types/react": "~19.1.0",
    "markdown-pdf": "^11.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  },
  "private": true
}
