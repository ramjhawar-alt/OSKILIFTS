# Client-side Supabase (accounts + cloud-synced workouts). Anon key is public by
# design (protected by RLS) — never put the service-role key here. Expo inlines
# EXPO_PUBLIC_* at build time, so set these in Vercel's env vars too.
# Run server/migrations/002_accounts_and_workouts.sql once before using.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
