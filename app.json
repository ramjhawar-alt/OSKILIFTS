{
  "expo": {
    "name": "OSKILIFTS",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OSKILIFTS checks whether you are at the RSF, only while the app is open, so your friends can see that you are there. Your exact location is never sent or saved."
        }
      ]
    ],
    "slug": "OSKILIFTS",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#003262"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oskilifts.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#DEA718"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.oskilifts.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "oskilifts",
    "extra": {
      "eas": {
        "projectId": "0ddcbc20-f61a-47e9-9ad4-32ac4680c537"
      }
    },
    "owner": "rj227"
  }
}
